{
  "name": "turf-booking-system-monorepo",
  "version": "1.0.0",
  "description": "Microservices Monorepo for Turf Booking System",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "client"
  ],
  "scripts": {
    "dev:gateway": "cd services/api-gateway && npm run dev",
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:user": "cd services/user-service && npm run dev",
    "dev:turf": "cd services/turf-service && npm run dev",
    "dev:booking": "cd services/booking-service && npm run dev",
    "dev:media": "cd services/media-service && npm run dev",
    "dev:notification": "cd services/notification-service && npm run dev",
    "dev:client": "cd client && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
